# Email Bison ------------------------------------------------------------
# Your workspace API key and the API base URL of your Bison instance.
EMAILBISON_API_KEY=
EMAILBISON_BASE_URL=https://your-bison-host/api

# MailReach --------------------------------------------------------------
# Key starts with mr_live_. Needed from step 5 onward (creating tests via the
# API, then polling + results). If you create tests in the dashboard instead,
# it is only needed from polling onward.
MAILREACH_API_KEY=

# Google Sheets (optional, step 8 only) ----------------------------------
# A short-lived OAuth access token with the spreadsheets scope. Any OAuth flow
# works; the quickest is:  gcloud auth print-access-token
# Leave blank if you are not writing results to a sheet.
GOOGLE_ACCESS_TOKEN=
