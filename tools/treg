#!/bin/sh
# Project-scoped treg CLI wrapper. Use this instead of any global `treg`.
# Binary: .treg/venv (gitignored). Config + login token: .treg/config.json (gitignored).
# Telemetry is off. Nothing is written to ~/.treg.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export TREG_CONFIG="$ROOT/.treg/config.json"
export TREG_TELEMETRY=0
export DO_NOT_TRACK=1
exec "$ROOT/.treg/venv/bin/treg" "$@"
